{
  "name": "dachitech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "大吃特吃 · 深圳及其他地方的本人实吃记录。",
  "scripts": {
    "data:build": "tsx scripts/import-food-sheet.ts",
    "data:build-notion": "tsx scripts/build-food-data.ts",
    "data:import-notion": "tsx scripts/import-notion.ts && tsx scripts/import-taste-club.ts",
    "data:audit": "tsx scripts/audit-data.ts",
    "images:manifest": "tsx scripts/images-manifest.ts",
    "images:sync": "tsx scripts/images-sync.ts",
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.2",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.20.3",
    "dotenv": "^16.4.5",
    "leaflet": "^1.9.4",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "xlsx": "^0.18.5"
  }
