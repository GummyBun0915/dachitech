---
/**
 * 城市页列表行（用户 2026-10-21 选定方案 1「紧凑行」：iPhone 一屏 ≥4 家）。
 * 左 92px 方图（点开灯箱看全部高清）· 中 名/分/榜单/品类/人均/一句话 · 右 导航。
 * 行本身可点 → 地图定位（由 city.ts 处理）；链接与按钮各管各的。
 */
import GuideBadge from "./GuideBadge.astro";
import { fmtPrice, fmtVisited, detailPath, navUrl, branchNavUrl, navProvider, asset, galleryData, type PubRestaurant } from "../lib/food-data";
import { cuisineGroupsOf } from "../lib/cuisine";
interface Props { r: PubRestaurant; i: number }
const { r, i } = Astro.props;
const price = fmtPrice(r);
const visited = fmtVisited(r);
const n = r.images.length;
const multi = r.branches.length > 1;
const hay = [r.brand, r.branch ?? "", ...r.branches.map((b) => b.name), ...r.cuisineTags, ...r.dishes.map((d) => d.name)].join(" ").toLowerCase();
---
<li class:list={["it", { "it--closed": r.closed }]}
  data-id={r.id} data-i={i} data-level={r.recommendationLevel}
  data-cats={cuisineGroupsOf(r.cuisineTags).join("|")} data-visited={r.visitedAt ?? ""} data-price={r.avgPrice ?? ""} data-hay={hay}>
  {n > 0 ? (
    <button type="button" class="it-img" data-gallery={galleryData(r)} data-shot="0" aria-label={`看 ${r.brand} 的实拍大图，共 ${n} 张`}>
      <img src={asset(r.images[0].thumb)} style={`object-position:${r.images[0].pos}`} width="92" height="92" alt="" loading={i < 6 ? "eager" : "lazy"} decoding="async" />
      {n > 1 && <span class="it-n num">{n}</span>}
    </button>
  ) : (
    <a class="it-img" href={detailPath(r)} tabindex="-1" aria-hidden="true"><span class="it-noimg">暂无照片</span></a>
  )}
  <div class="it-text">
    <h2 class="it-h"><a class="it-name" href={detailPath(r)}>{r.brand}{!multi && r.branch && <span class="it-branch"> · {r.branch}</span>}</a></h2>
    <p class="it-line">
      <GuideBadge level={r.recommendationLevel} closed={r.closed} />
      {r.cuisineTags.length > 0 && <span class="it-cui">{r.cuisineTags.slice(0, 2).join(" · ")}</span>}
      {price && <span class="num it-price">{price.replace("/人", "")}</span>}
    </p>
    {(r.reviewText || r.dishes.length > 0) && (
      <p class="it-sub">{r.reviewText || `推荐 ${r.dishes.slice(0, 3).map((d) => d.name).join("、")}`}</p>
    )}
    {multi && (
      /* 多门店：直接列出门店，点哪家地图就定位哪家（city.ts）；关店门店置灰 */
      <p class="it-brs" aria-label={`${r.branches.length} 家门店`}>
        {r.branches.map((b) => (
          <button type="button" class:list={["it-br", { "it-br--closed": b.closed, "it-br--nopos": b.lng === null }]}
            data-branch={b.name} title={b.lng === null ? "这家门店还没有坐标" : `在地图上看 ${b.name}`}>{b.name || r.brand}{b.closed && "（已关）"}</button>
        ))}
      </p>
    )}
    <p class="it-foot">
      {visited && <span class="num">{visited}</span>}
      <span class="it-dist num" data-dist></span>
    </p>
  </div>
  {multi ? (
    /* 多门店导航：点开选门店，每家独立跳转 */
    <details class="it-navwrap">
      <summary class="it-nav" aria-label={`选择 ${r.brand} 的门店导航`}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <span class="it-nav-n num">{r.branches.length}</span>
      </summary>
      <ul class="it-menu">
        <li class="it-menu-h">导航到哪家？</li>
        {r.branches.map((b) => (
          <li><a href={branchNavUrl(r, b)} target="_blank" rel="noopener noreferrer"><span>{b.name || r.brand}{b.closed && <em>已关店</em>}</span>{b.address && <small>{b.address}</small>}</a></li>
        ))}
      </ul>
    </details>
  ) : (
    <a class="it-nav" href={navUrl(r)} target="_blank" rel="noopener noreferrer" aria-label={`在${navProvider(r)}打开${r.brand}`}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
    </a>
  )}
</li>

<style>
  .it { position: relative; display: grid; grid-template-columns: 92px 1fr auto; gap: 12px; align-items: start; padding: 12px 16px; border-bottom: 1px solid var(--line); cursor: pointer; transition: background var(--t); }
  .it[hidden] { display: none; }
  .it:hover, :global(.it.is-on) { background: var(--op-soft); }
  :global(.it.is-on) { box-shadow: inset 3px 0 0 var(--op); }
  .it-img { position: relative; display: block; width: 92px; height: 92px; padding: 0; border: 0; border-radius: var(--r-image); overflow: hidden; background: var(--paper-2); cursor: zoom-in; }
  a.it-img { cursor: pointer; }
  .it-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .it-noimg { display: grid; place-items: center; height: 100%; font-size: 11px; color: var(--ink-3); }
  .it-n { position: absolute; right: 4px; bottom: 4px; padding: 0 5px; border-radius: 4px; background: rgba(18, 18, 22, 0.62); color: #fff; font-size: 10px; line-height: 16px; }
  .it-text { min-width: 0; display: grid; gap: 3px; align-content: start; }
  .it-h { font-size: 15.5px; font-weight: 650; line-height: 1.3; letter-spacing: var(--ls-text); }
  .it-name { color: var(--ink); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .it-branch { font-weight: 500; color: var(--ink-2); font-size: 13px; }
  .it-line { display: flex; align-items: center; flex-wrap: wrap; gap: 2px 6px; font-size: 12.5px; color: var(--ink-2); }
  .it-price { color: var(--ink); font-weight: 600; }
  .it-sub { font-size: 12.5px; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .it-foot { display: flex; gap: 8px; font-size: 11.5px; color: var(--ink-3); }
  .it-dist:empty { display: none; }
  .it-brs { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px; }
  .it-br { height: 24px; padding: 0 8px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); font-size: 12px; color: var(--ink); cursor: pointer; }
  .it-br:hover { border-color: var(--op); color: var(--op); }
  :global(.it-br.is-on) { background: var(--op); border-color: var(--op); color: #fff; }
  .it-br--closed { color: var(--ink-3); text-decoration: line-through; }
  .it-br--nopos { border-style: dashed; color: var(--ink-2); }
  .it-navwrap { position: relative; align-self: center; }
  .it-navwrap > summary { list-style: none; cursor: pointer; position: relative; }
  .it-navwrap > summary::-webkit-details-marker { display: none; }
  .it-nav-n { position: absolute; right: -4px; top: -4px; min-width: 16px; height: 16px; border-radius: 8px; background: var(--ink); color: #fff; font-size: 10px; line-height: 16px; text-align: center; }
  .it-menu { position: absolute; right: 0; top: 42px; z-index: 30; width: 230px; margin: 0; padding: 6px; list-style: none; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-overlay); box-shadow: 0 8px 24px rgba(18, 18, 22, 0.16); }
  .it-menu-h { padding: 4px 8px 6px; font-size: 12px; color: var(--ink-3); }
  .it-menu a { display: grid; gap: 1px; padding: 8px; border-radius: 6px; color: var(--ink); font-size: 14px; font-weight: 600; }
  .it-menu a:hover { background: var(--op-soft); text-decoration: none; }
  .it-menu small { font-size: 11.5px; font-weight: 400; color: var(--ink-2); }
  .it-menu em { font-style: normal; font-weight: 500; font-size: 11px; color: var(--ink-3); margin-left: 6px; }
  .it-nav { width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--ink); align-self: center; }
  .it-nav:hover { border-color: var(--op); color: var(--op); text-decoration: none; }
  .it--closed { opacity: 0.6; }
  .it--closed .it-img { filter: grayscale(1); }
</style>
