---
import Layout from "../components/Layout.astro";
import RestaurantCard from "../components/RestaurantCard.astro";
import GuideBadge from "../components/GuideBadge.astro";
import {
  REGION_ORDER, regionName, regionCount, regionWait, regionPath,
  recentEats, guideList, waitList, restaurants, isEaten, lastUpdated, fmtVisited,
} from "../lib/food-data";

const updated = lastUpdated();
// 星其林（用户 2026-10-21）：星级店按 三星 → 二星 → 一星 一栏；必吃登单独一栏
const starred = [...guideList("s3"), ...guideList("s2"), ...guideList("s1")];
const bibs = guideList("bib");
const eaten = restaurants.filter(isEaten);
const latest = [...eaten].sort((a, b) => b.contentUpdatedAt.localeCompare(a.contentUpdatedAt)).slice(0, 6);
---
<Layout>
  {/* 品牌海报块：fal 展示语域，首尾同色闭环 */}
  <section class="hero">
    <div class="page page-inner">
      <p class="hero-kicker">星其林 · 私人美食指南</p>
      <h1 class="display">大吃特吃</h1>
      <p class="hero-desc">只写亲口吃过的店。深圳为主，走到哪吃到哪。</p>
      {updated && <p class="hero-updated">最后更新 <span class="num">{updated}</span></p>}
    </div>
  </section>

  {/* 地区入口：数量为同一发布数据集的真实计数 */}
  <section class="page page-inner block">
    <div class="region-grid">
      {REGION_ORDER.map((s) => (
        <a class="region-entry" href={regionPath(s)}>
          <span class="region-name">{regionName(s)}</span>
          <span class="num region-count">{regionCount(s) + regionWait(s) === 0 ? "还没开吃" : <>实吃 {regionCount(s)}{regionWait(s) > 0 && <span class="region-wait"> · 待吃 {regionWait(s)}</span>}</>}</span>
        </a>
      ))}
    </div>
  </section>

  {/* 最近吃了：无数据则收起（Q3 窗口内当前真实为 0） */}
  {recentEats.length > 0 && (
    <section class="page page-inner block">
      <h2 class="section-title">最近吃了</h2>
      <div class="card-grid">{recentEats.map((r) => <RestaurantCard r={r} variant="album" />)}</div>
    </section>
  )}

  {starred.length > 0 && (
    <section class="page page-inner block">
      <h2 class="section-title">星其林 · 摘星 <span class="block-sub">星数越多，越值得专门跑一趟</span></h2>
      <ul class="guide-key" aria-label="星级含义">
        <li><GuideBadge level="s3" /> 值得专程</li>
        <li><GuideBadge level="s2" /> 值得绕路</li>
        <li><GuideBadge level="s1" /> 同类里出色</li>
      </ul>
      <div class="card-grid">{starred.map((r) => <RestaurantCard r={r} variant="album" />)}</div>
    </section>
  )}

  {bibs.length > 0 && (
    <section class="page page-inner block">
      <h2 class="section-title">必吃登推介 <span class="block-sub">人均 ¥80 以内，好吃不贵，常去不腻</span></h2>
      <div class="card-grid">{bibs.map((r) => <RestaurantCard r={r} variant="album" />)}</div>
    </section>
  )}

  {/* 待吃：计划吃、还没吃（无实吃证据，单独一档） */}
  {waitList.length > 0 && (
    <section class="page page-inner block">
      <h2 class="section-title">待吃清单 <span class="block-sub">已种草，还没去</span></h2>
      <div class="card-grid">{waitList.map((r) => <RestaurantCard r={r} variant="album" />)}</div>
    </section>
  )}

  {/* 最新收录（有数据时的真实内容） */}
  {latest.length > 0 && (
    <section class="page page-inner block">
      <h2 class="section-title">新近收录 <span class="block-sub">共 {eaten.length} 家实吃</span></h2>
      <div class="card-grid">{latest.map((r) => <RestaurantCard r={r} variant="album" />)}</div>
    </section>
  )}

  {/* 闭环：与首屏同色收尾 */}
  <section class="closing">
    <div class="page page-inner">
      <p>应吃尽吃</p>
    </div>
  </section>
</Layout>

<style>
  .hero { background: var(--brand); padding-block: var(--s-16) var(--s-12); color: var(--ink); }
  .hero-kicker { font-size: var(--fs-sub); font-weight: 600; margin-bottom: var(--s-4); }
  .hero-desc { margin-top: var(--s-4); font-size: clamp(1.125rem, 1vw + 0.9rem, 1.5rem); letter-spacing: var(--ls-text); }
  .hero-updated { margin-top: var(--s-6); font-size: var(--fs-sub); color: var(--ink); opacity: 0.72; }
  .block { margin-top: var(--s-12); display: grid; gap: var(--s-6); }
  .region-grid { display: grid; grid-template-columns: 1fr; gap: var(--s-3); }
  @media (min-width: 768px) { .region-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .region-grid { grid-template-columns: repeat(3, 1fr); } }
  .region-entry {
    display: flex; align-items: baseline; justify-content: space-between;
    padding: var(--s-6); border: 1px solid var(--line); border-radius: var(--r-card);
    color: var(--ink); transition: transform var(--t), opacity var(--t);
  }
  .region-entry:hover { text-decoration: none; background: var(--brand-soft); }
  .region-name { font-size: var(--fs-shop); font-weight: 600; letter-spacing: var(--ls-text); }
  .region-count { color: var(--ink-2); font-size: var(--fs-sub); }
  .region-wait { color: #9a5a12; }
  .guide-key { list-style: none; margin: calc(-1 * var(--s-3)) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); font-size: var(--fs-sub); color: var(--ink-2); }
  .guide-key li { display: flex; align-items: center; gap: 6px; }
  .block-sub { font-size: var(--fs-sub); font-weight: 500; color: var(--ink-3); letter-spacing: 0; }
  .card-grid { display: grid; grid-template-columns: 1fr; gap: var(--s-4); }
  @media (min-width: 768px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .card-grid { grid-template-columns: repeat(3, 1fr); } }
  .closing { background: var(--brand); margin-top: var(--s-16); padding-block: var(--s-12); }
  .closing p { font-size: var(--fs-section); font-weight: 600; letter-spacing: var(--ls-display); }
</style>
